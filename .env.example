# Grosznik — zmienne srodowiskowe
# Skopiuj jako .env i wypelnij przed uruchomieniem

# Klucz podpisywania JWT (wygeneruj: openssl rand -hex 32)
JWT_SECRET=change_me_in_production_please

# Token bota Telegram (uzyskaj od @BotFather)
TELEGRAM_BOT_TOKEN=

# Numeryczne ID uzytkownikow Telegram oddzielone przecinkiem
TELEGRAM_ALLOWED_USERS=
